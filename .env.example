# ==============================================================================
# Environment Configuration (.env.example)
# Client Insights API
# ==============================================================================

# Application
APP_NAME=client-insights-api
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=client_insights
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/client_insights

# Redis (Cache, Broker & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Encryption (Fernet / AES-256)
SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long
ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfZXhhbXBsZV9rZXlfMTI= # Base64 encoded 32-byte key
# Previous keys (comma-separated) so existing ciphertext decrypts during rotation
ENCRYPTION_FALLBACK_KEYS=

# Observability (optional; leave empty locally)
SENTRY_DSN=

# Google Gemini API (Exclusive LLM Provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Trello API Credentials
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_SECRET=your_trello_secret

# Email Delivery (Resend / Postmark / SES)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=notifications@yourdomain.com
