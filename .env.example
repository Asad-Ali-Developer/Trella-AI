# ==============================================================================
# Environment Configuration (.env.example)
# Client Insights API
# ==============================================================================

# Application
APP_NAME=client-insights-api
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
# Enable Secure in production; use SameSite=none only when frontend/API are cross-site.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=client_insights
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/client_insights

# Redis (Cache, Broker & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security & Encryption (Fernet / AES-256)
SECRET_KEY=change_this_to_a_super_secret_key_minimum_32_characters_long
ENCRYPTION_KEY=dGhpc19pc19hXzMyX2J5dGVfZXhhbXBsZV9rZXlfMTI= # Base64 encoded 32-byte key
# Previous keys (comma-separated) so existing ciphertext decrypts during rotation
ENCRYPTION_FALLBACK_KEYS=

# Observability (optional; leave empty locally)
SENTRY_DSN=

# Google Gemini API (Exclusive LLM Provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Trello API token authorization
# Add the API key from Trello App Admin > Trello Auth.
TRELLO_API_KEY=
TRELLO_TOKEN_RETURN_URL=http://localhost:3000/dashboard/trello/callback
TRELLO_TOKEN_SCOPE=read
TRELLO_TOKEN_EXPIRATION=never
# Required for live sync webhooks; use a public HTTPS tunnel during local development.
TRELLO_WEBHOOK_CALLBACK_URL=
# Trello App Admin > Trello Auth > Secret (used to verify X-Trello-Webhook).
TRELLO_WEBHOOK_SECRET=

# Legacy Trello OAuth 2.0 confidential client
# Use the Client ID and secret from Trello App Admin > OAuth 2.0.
TRELLO_OAUTH_CLIENT_ID=
TRELLO_OAUTH_CLIENT_SECRET=
TRELLO_API_BASE_URL=https://api.trello.com/1
TRELLO_OAUTH_CALLBACK_URL=http://localhost:3000/dashboard/trello/callback
# Configure read:board:trello, read:organization:trello, and read:member:trello on the app.
TRELLO_OAUTH_SCOPES=read:board:trello read:organization:trello read:member:trello offline_access

# GitHub OAuth App (configure the callback URL exactly as shown)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/dashboard/github/callback
GITHUB_API_BASE_URL=https://api.github.com

# Transactional email (Docker Compose uses local Mailpit by default)
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@client-insights.local
SMTP_STARTTLS=false
SMTP_USE_SSL=false
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email Delivery (Resend / Postmark / SES)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=notifications@yourdomain.com
